---
import { getEntry } from 'astro:content';

interface Props {
  id: string;
  label?: string;
}

const { id, label } = Astro.props;
const entry = await getEntry('glossary', id);

if (!entry) {
  throw new Error(`GlossaryTerm: termo "${id}" não encontrado em src/data/glossary.json`);
}

const { term, category, shortDef, causalMechanism } = entry.data;
const uid = `gloss-${id}-${Math.random().toString(36).slice(2, 7)}`;
const anchorName = `--anchor-${uid}`;
---

<span class="inline">
  <button
    type="button"
    popovertarget={uid}
    class="glossary-trigger"
    style={`anchor-name: ${anchorName};`}
    aria-label={`Definir termo técnico: ${term}`}
  >
    {label ?? term}
  </button>

  <span
    id={uid}
    popover="auto"
    class="glossary-popover"
    style={`position-anchor: ${anchorName};`}
    role="region"
    aria-label={`Definição de ${term}`}
  >
    <span class="flex items-baseline justify-between gap-2 pb-2 mb-2 border-b border-line">
      <strong class="font-display text-sm font-semibold text-ink">{term}</strong>
      <span class="font-mono text-[10px] uppercase tracking-wider text-ocean">{category}</span>
    </span>
    <span class="block text-xs leading-relaxed text-ink mb-2">
      {shortDef}
    </span>
    <span class="block text-xs leading-relaxed text-ink-secondary pt-2 border-t border-line">
      <strong class="font-mono text-[10px] uppercase tracking-wider text-salvage block mb-0.5">
        Mecanismo causal
      </strong>
      {causalMechanism}
    </span>
  </span>
</span>
