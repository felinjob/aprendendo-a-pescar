---
interface Props {
  id: string;
  number: number;
}

const { id, number } = Astro.props;
const inputId = `sn-toggle-${id}`;
---

<span class="sidenote-wrapper">
  <label
    for={inputId}
    class="sidenote-ref"
    title={`Nota marginal ${number}`}
  >
    {number}
  </label>
  <input
    type="checkbox"
    id={inputId}
    class="sidenote-toggle-input"
    aria-label={`Alternar nota marginal ${number}`}
  />
  <span class="sidenote-content" role="note">
    <span class="font-mono text-[10px] font-bold text-salvage mr-1.5">[{number}]</span>
    <slot />
  </span>
</span>
