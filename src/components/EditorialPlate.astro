---
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  plateNumber: string;
  caption: string;
  aspect?: '16/9' | '21/9' | '4/3';
  priority?: boolean;
  fullBleed?: boolean;
}

const {
  image,
  alt,
  plateNumber,
  caption,
  aspect = '16/9',
  priority = false,
  fullBleed = false,
} = Astro.props;

const aspectClass =
  aspect === '21/9'
    ? 'aspect-[21/9]'
    : aspect === '4/3'
      ? 'aspect-[4/3]'
      : 'aspect-[16/9]';
---

<figure
  class:list={[
    'my-8 m-0',
    fullBleed ? 'tufte-full-bleed' : '',
  ]}
>
  <div
    class:list={[
      'relative w-full overflow-hidden bg-surface border-t border-b border-line',
      aspectClass,
    ]}
  >
    <img
      src={image.src}
      width={image.width}
      height={image.height}
      alt={alt}
      loading={priority ? 'eager' : 'lazy'}
      decoding={priority ? 'sync' : 'async'}
      referrerpolicy="no-referrer"
      class="h-full w-full object-cover block"
    />
  </div>
  <figcaption class="mt-2.5 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 text-xs leading-relaxed text-ink-secondary">
    <span>
      <strong class="font-mono text-[11px] font-semibold uppercase tracking-wider text-salvage mr-2">
        {plateNumber}
      </strong>
      {caption}
    </span>
  </figcaption>
</figure>
