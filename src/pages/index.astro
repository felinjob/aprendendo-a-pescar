---
import { getCollection } from 'astro:content';
import StudyLayout from '../layouts/StudyLayout.astro';
import EditorialPlate from '../components/EditorialPlate.astro';
import Sidenote from '../components/Sidenote.astro';
import GlossaryTerm from '../components/GlossaryTerm.astro';
import MnemonicDeck from '../components/islands/MnemonicDeck.svelte';
import heroWakeImg from '../assets/images/hero_offshore_wake_1795644457360.jpg';

const fsrsEntries = await getCollection('fsrsPrompts');
const prompts = fsrsEntries.map((entry) => entry.data);

const sectionNav = [
  { id: 'atlas-capitulos', label: 'Mapa da Monografia' },
  { id: 'ecossistema-clubes', label: 'Circuito de Iate Clubes' },
  { id: 'cinco-modalidades', label: 'As 5 Modalidades' },
  { id: 'recordes-brasileiros', label: '3 Recordes Mundiais IGFA' },
  { id: 'slams-igfa', label: 'IGFA Slams & OWC' },
  { id: 'fsrs-deck', label: 'Revisão Espaçada (24)' },
];

const CHAPTER_MAP = [
  {
    num: '02',
    href: '/tralha',
    title: 'Engenharia da Tralha, Linhas & Nós',
    desc: 'Blanks, cerâmicas Fuji, carretilhas 2-speed, escala PE, óptica do fluorocarbono, nós e corrosão galvânica na crimpagem.',
    tools: 'Simulador de Blank · Raio-X do Carretel · Calculadoras PE/CPT/Jig',
  },
  {
    num: '03–04',
    href: '/tatica',
    title: 'Eletrônica, Táticas (Mar & Água Doce) & Oceanografia',
    desc: 'Cascos, VHF, CHIRP/Omni 360°, spread de corrico, bait-and-switch, talude/ressurgência, ciência vs. folclore, surfcasting, pesqueiros e fly.',
    tools: 'Scrollytelling do Spread · Explorador Batimétrico & Óptico · VHF/Sonar',
  },
  {
    num: '06',
    href: '/especies',
    title: 'Enciclopédia de Espécies & Ciência do Pesque-e-Solte',
    desc: '22 espécies brasileiras (água doce, estuário e mar aberto), biologia reprodutiva, circle hook inline vs. offset 15°, Cooke 2022 e barotrauma.',
    tools: 'Enciclopédia Interativa (22 spp.) · Gráficos Okabe-Ito de Conservação',
  },
  {
    num: '05 & 07',
    href: '/regras-lei',
    title: 'Regras IGFA, Bandeiras & Legislação 2026/2027',
    desc: 'Classes 2–130 lb, 6 causas de DQ, adriça 1→7, licença Gov.br, Transporte Zero/Piracema e Portarias GM/MMA nº 1.666 e 1.667/2026.',
    tools: 'Auditor IGFA · Montador de Adriça · Explorador Legal 2026 (17 spp.)',
  },
  {
    num: '08',
    href: '/cais',
    title: 'Sobrevivência no Cais, Manutenção & Glossário',
    desc: 'Protocolo pós-mar em 5 passos (MagSealed/WD-40), 10 erros de iniciante, 10 mandamentos de convés, 6 perguntas inteligentes e 38 verbetes.',
    tools: 'Checklist Pós-Mar IndexedDB · Glossário Global Pesquisável',
  },
];

const WORLD_RECORDS = [
  {
    species: 'Marlin-Azul (Atlântico)',
    scientific: 'Makaira nigricans',
    weight: '636,0 kg',
    imperial: '1.402 lb 2 oz',
    angler: 'Paulo Amorim',
    place: 'Vitória (ES) · 29/02/1992',
    note: 'Recorde mundial absoluto All-Tackle imbatível há mais de três décadas — um Grander histórico em águas capixabas.',
  },
  {
    species: 'Marlin-Branco',
    scientific: 'Kajikia albida',
    weight: '82,5 kg',
    imperial: '181 lb 14 oz',
    angler: 'Evandro Coser',
    place: 'Vitória (ES) · 08/12/1979',
    note: 'Recorde mundial All-Tackle estabelecido no auge da pesca de talude no Espírito Santo; hoje a espécie opera sob C&R estrito no Brasil.',
  },
  {
    species: 'Namorado',
    scientific: 'Pseudopercis numida',
    weight: '20,2 kg',
    imperial: '44 lb 8 oz',
    angler: 'Eduardo Baumeier',
    place: 'Cabo Frio / Arraial (RJ)',
    note: 'Marco mundial de pesca demersal em parcéis fundos da plataforma fluminense sob influência da ressurgência.',
  },
];
---

<StudyLayout
  title="Aprendendo a Pescar · Monografia Técnica & Caderno de Campo"
  chapterNumber="Cap. 01 · Capa Editorial"
  chapterTitle="Atlas & Ecossistema"
  activeRoute="/"
  sectionNav={sectionNav}
>
  <!-- HERO EDITORIAL ASSIMÉTRICO -->
  <header class="pb-8 border-b border-line">
    <p class="m-0 font-mono text-[11px] font-semibold uppercase tracking-[0.16em] text-salvage">
      Monografia Interativa · Circuito de Iate Clubes, Água Doce &amp; Vigência Legal Nov/2026
    </p>
    <h1 class="font-display text-4xl sm:text-5xl lg:text-[3.4rem] font-semibold leading-[1.06] tracking-[-0.025em] text-ink mt-3 mb-5 max-w-[18ch]">
      A física, a tática e o código do mar e dos rios.
    </h1>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-end">
      <p class="lg:col-span-7 m-0 text-base sm:text-lg leading-relaxed text-ink-secondary max-w-[58ch]">
        Caderno técnico de estudo e referência rápida de convés. Prosa seca orientada a causa e consequência, instrumentos de campo local-first, enciclopédia de 22 espécies brasileiras e auditoria completa das <strong>Portarias GM/MMA nº 1.666 e 1.667/2026</strong>.
      </p>

      <div class="lg:col-span-5 flex flex-wrap gap-x-6 gap-y-2 lg:justify-end font-mono text-xs tabular-telemetry border-t border-line pt-3 lg:border-t-0 lg:pt-0">
        <div>
          <span class="block text-[10px] uppercase tracking-wider text-ink-muted">Módulos</span>
          <strong class="text-ink">08 Capítulos · 6 Rotas</strong>
        </div>
        <div>
          <span class="block text-[10px] uppercase tracking-wider text-ink-muted">Retenção FSRS</span>
          <strong class="text-ocean">{prompts.length} Cartões Ativos</strong>
        </div>
        <div>
          <span class="block text-[10px] uppercase tracking-wider text-ink-muted">Operação</span>
          <strong class="text-salvage">PWA Offline</strong>
        </div>
      </div>
    </div>
  </header>

  <!-- PRANCHA VISUAL 01: ESTEIRA OCEÂNICA -->
  <EditorialPlate
    image={heroWakeImg}
    alt="Cockpit de popa de embarcação sportfisher cortando águas azuis oceânicas pela manhã com carretilha dourada pesada e esteira branca ao fundo"
    plateNumber="Prancha 01"
    caption="Popa de sportfisher em cruzeiro de corrico rumo ao corte do talude continental (43–55 MN): onde a geometria da esteira, o drag calibrado na balança e a leitura da água decidem o dia."
    aspect="21/9"
    priority={true}
  />

  <!-- MAPA DOS CAPÍTULOS (REDAÇÃO DE CAPA ABERTA, SEM CARDS QUADRADOS) -->
  <section id="atlas-capitulos" class="editorial-band-strong">
    <div class="flex flex-wrap items-baseline justify-between gap-2 mb-6">
      <div>
        <p class="m-0 font-mono text-[11px] font-semibold uppercase tracking-[0.14em] text-salvage">
          Índice Estruturado
        </p>
        <h2 class="font-display text-2xl sm:text-3xl font-semibold text-ink mt-1 mb-0">
          Os Capítulos da Monografia
        </h2>
      </div>
      <span class="font-mono text-xs text-ink-muted">
        Alterne para <strong>Modo Cais</strong> no topo para ocultar teoria no barco
      </span>
    </div>

    <div class="divide-y divide-line border-t border-b border-line">
      {CHAPTER_MAP.map((ch) => (
        <a
          href={ch.href}
          class="group grid grid-cols-1 md:grid-cols-12 gap-3 md:gap-6 py-5 no-underline transition-colors hover:bg-surface/60 px-2 -mx-2"
        >
          <div class="md:col-span-2 font-mono text-xs font-semibold uppercase tracking-widest text-salvage pt-1">
            Cap. {ch.num}
          </div>
          <div class="md:col-span-6">
            <h3 class="font-display text-xl font-semibold text-ink m-0 group-hover:text-salvage transition-colors">
              {ch.title} →
            </h3>
            <p class="mt-1.5 mb-0 text-sm leading-relaxed text-ink-secondary">
              {ch.desc}
            </p>
          </div>
          <div class="md:col-span-4 md:text-right flex flex-col justify-center">
            <span class="font-mono text-[10px] uppercase tracking-wider text-ink-muted">
              Instrumentos Interativos
            </span>
            <span class="mt-1 font-mono text-xs text-ocean">
              {ch.tools}
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- CAPÍTULO 01: ECOSSISTEMA DE IATE CLUBES -->
  <section id="ecossistema-clubes" data-study-only class="editorial-band-strong">
    <p class="m-0 font-mono text-[11px] font-semibold uppercase tracking-[0.14em] text-salvage">
      Capítulo 01 · Ecossistema Náutico &amp; Competição
    </p>
    <h2 class="font-display text-2xl sm:text-3xl font-semibold text-ink mt-1.5 mb-6">
      O Circuito Brasileiro de Iate Clubes (ICRJ, ICES &amp; YCI)
    </h2>

    <div class="tufte-article-grid">
      <div class="tufte-flow editorial-prose">
        <p>
          A pesca oceânica esportiva no Brasil nasceu e se profissionalizou nos departamentos de pesca dos grandes iate clubes do Sudeste. Muito além de lazer, o circuito integra três pilares históricos: o <strong>Iate Clube do Rio de Janeiro (ICRJ)</strong>, com tradição de pesca de alto-mar iniciada na década de 1930; o <strong>Iate Clube do Espírito Santo (ICES)</strong>, porta de saída para os grandes bancos de marlins de Vitória; e o <strong>Yacht Club de Ilhabela (YCI)</strong>, epicentro das etapas paulistas no canal de São Sebastião e ao largo do <GlossaryTerm id="talude" label="talude" />.<Sidenote id="icrj-hist" number={1}>O departamento de pesca do ICRJ estrutura temporadas oficiais de verão (Peixes de Bico, nov–fev) e inverno (Anchova e Fundo, mai–set), servindo de classificatória brasileira para o Offshore World Championship na Costa Rica.</Sidenote>
        </p>

        <p>
          O peso técnico dessa escola brasileira aparece no palco mundial: no <strong>Offshore World Championship (OWC)</strong>, disputado em Quepos (Costa Rica), equipes brasileiras classificadas via clubes nacionais competem em igualdade com a elite internacional — com presenças marcantes como a equipe <strong>Cocoroca</strong> (2024) e a <strong>Meirmão</strong> (2026), além da evolução regulamentar de 2026 que passou a valorizar capturas sem sonar omnidirecional 360° para preservar o mérito de leitura de mar.
        </p>
      </div>
    </div>
  </section>

  <!-- AS 5 MODALIDADES DO CIRCUITO -->
  <section id="cinco-modalidades" data-cais-keep class="editorial-band">
    <p class="m-0 font-mono text-[11px] font-semibold uppercase tracking-[0.14em] text-ocean">
      Classificação Operacional
    </p>
    <h2 class="font-display text-2xl font-semibold text-ink mt-1 mb-5">
      As 5 Modalidades dos Clubes &amp; Ambientes Brasileiros
    </h2>

    <div class="overflow-x-auto">
      <table class="editorial-table">
        <thead>
          <tr>
            <th>Modalidade</th>
            <th>Zona &amp; Distância</th>
            <th>Alvos Principais</th>
            <th>Tralha-Padrão &amp; Técnica</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="font-display text-base font-semibold text-ink">Oceânica Pesada (Peixes de Bico)</td>
            <td class="font-mono text-xs">Talude · 43–55 MN<br />100 → 1.000+ m</td>
            <td>Marlin-Azul, Marlin-Branco, Sailfish, Atum, Wahoo, Dourado</td>
            <td>Carretilhas lever drag 30W–80W, <GlossaryTerm id="spread" label="spread" /> a 7–8 nós e <GlossaryTerm id="bait-and-switch" label="bait-and-switch" /> com circle hook.</td>
          </tr>
          <tr>
            <td class="font-display text-base font-semibold text-ink">Jigging Vertical (Speed &amp; Slow)</td>
            <td class="font-mono text-xs">Parcéis &amp; Lajes<br />30 → 200 m</td>
            <td>Olho-de-Boi, Olhete, Garoupa, Sirigado, Pargo, Cherne-Verdadeiro</td>
            <td>Carretilhas star drag (Ocea Jigger / Saltiga), PE 1.5–4.0, jigs metálicos de 80 a 400 g.</td>
          </tr>
          <tr>
            <td class="font-display text-base font-semibold text-ink">Costeira &amp; Ilhas (Arremesso / Fundeio)</td>
            <td class="font-mono text-xs">Costões &amp; Ilhas<br />5 → 35 m</td>
            <td>Anchova, Xaréu, Sororoca, Badejo, Robalo-Flecha</td>
            <td>Molinetes 4000–6000 ou carretilhas perfil baixo, plugs, stickbaits, micro jigs e isca viva.</td>
          </tr>
          <tr>
            <td class="font-display text-base font-semibold text-ink">Estuário, Mangue &amp; Praia (Surfcasting)</td>
            <td class="font-mono text-xs">Canais &amp; Arrebentação<br />0 → 12 m</td>
            <td>Robalo-Peva, Robalo-Flecha, Tarpon, Pampo, Betara, Corvina</td>
            <td>Finesse PE 0.6–1.2 com camarão soft/vivo; varas 4,2 m com <GlossaryTerm id="shock-leader" label="shock leader" /> na praia.</td>
          </tr>
          <tr>
            <td class="font-display text-base font-semibold text-ink">Água Doce (Rios, Represas &amp; Pesqueiros)</td>
            <td class="font-mono text-xs">Bacias Continentais &amp; Lagos</td>
            <td>Tucunaré-Açu/Azul, Dourado, Trairão, Surubins, Piraíba, Tambaqui</td>
            <td>Perfil baixo (12–30 lb) em artificiais; perfil redondo pesada (80–120 lb) em couros; Fly #3–#12 e boia cevadeira.</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- OS 3 RECORDES MUNDIAIS IGFA EM ÁGUAS BRASILEIRAS -->
  <section id="recordes-brasileiros" data-cais-keep class="editorial-band-strong">
    <p class="m-0 font-mono text-[11px] font-semibold uppercase tracking-[0.14em] text-salvage">
      Patrimônio Esportivo · International Game Fish Association
    </p>
    <h2 class="font-display text-2xl sm:text-3xl font-semibold text-ink mt-1.5 mb-6">
      Os 3 Recordes Mundiais IGFA Conquistados no Brasil
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 border-t border-b border-line py-6 tabular-telemetry">
      {WORLD_RECORDS.map((rec, i) => (
        <article class="flex flex-col justify-between">
          <div>
            <span class="font-mono text-[10px] font-semibold uppercase tracking-widest text-ink-muted">
              Recorde 0{i + 1} · All-Tackle
            </span>
            <p class="font-display text-4xl font-semibold text-salvage mt-2 mb-0 leading-none">
              {rec.weight}
            </p>
            <p class="font-mono text-xs text-ink-muted mt-1 mb-3">
              {rec.imperial}
            </p>
            <h3 class="font-display text-xl font-semibold text-ink m-0">
              {rec.species}
            </h3>
            <p class="font-mono text-[11px] italic text-ocean mt-0.5 mb-3">
              {rec.scientific}
            </p>
            <p class="text-sm leading-relaxed text-ink-secondary m-0">
              {rec.note}
            </p>
          </div>
          <p class="mt-4 pt-3 border-t border-line font-mono text-[11px] text-ink m-0">
            <strong>{rec.angler}</strong> · {rec.place}
          </p>
        </article>
      ))}
    </div>
  </section>

  <!-- IGFA SLAMS -->
  <section id="slams-igfa" data-study-only class="editorial-band">
    <p class="m-0 font-mono text-[11px] font-semibold uppercase tracking-[0.14em] text-ocean">
      Clubes de Conquista IGFA
    </p>
    <h2 class="font-display text-2xl font-semibold text-ink mt-1 mb-5">
      Hierarquia dos IGFA Slams (Do Dia à Vida Inteira)
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 border-t border-line pt-5">
      <div>
        <span class="font-mono text-[11px] font-semibold text-salvage uppercase">01 · Grand Slam</span>
        <h3 class="font-display text-lg font-semibold text-ink mt-1 mb-1.5">3 Espécies no Mesmo Dia</h3>
        <p class="text-xs leading-relaxed text-ink-secondary m-0">
          Capturar e liberar três espécies distintas elegíveis no mesmo dia civil (ex.: Marlin-Azul + Marlin-Branco + Sailfish no Billfish Grand Slam).
        </p>
      </div>
      <div>
        <span class="font-mono text-[11px] font-semibold text-salvage uppercase">02 · Super Grand Slam</span>
        <h3 class="font-display text-lg font-semibold text-ink mt-1 mb-1.5">4 Espécies no Mesmo Dia</h3>
        <p class="text-xs leading-relaxed text-ink-secondary m-0">
          Quatro espécies distintas do grupo no mesmo dia (ex.: incluir Spearfish ou Broadbill Swordfish aos três peixes de bico clássicos).
        </p>
      </div>
      <div>
        <span class="font-mono text-[11px] font-semibold text-ocean uppercase">03 · Fantasy Slam</span>
        <h3 class="font-display text-lg font-semibold text-ink mt-1 mb-1.5">5 Espécies no Mesmo Dia</h3>
        <p class="text-xs leading-relaxed text-ink-secondary m-0">
          Feito raríssimo de cinco espécies elegíveis em 24 horas — exige logística de talude diurno e pesca profunda noturna de espadarte.
        </p>
      </div>
      <div>
        <span class="font-mono text-[11px] font-semibold text-ink uppercase">04 · Royal Slam</span>
        <h3 class="font-display text-lg font-semibold text-ink mt-1 mb-1.5">Todas as 9 na Vida</h3>
        <p class="text-xs leading-relaxed text-ink-secondary m-0">
          Completar ao longo da carreira todas as 9 espécies reconhecidas de peixes de bico da IGFA ao redor dos oceanos Atlântico, Pacífico e Índico.
        </p>
      </div>
    </div>
  </section>

  <!-- REVISÃO ESPAÇADA GLOBAL (24 CARTÕES) -->
  <div class="mt-10">
    <MnemonicDeck
      client:visible
      prompts={prompts}
      heading="Fila Global de Retenção Espaçada (Cap. 01 a 08)"
    />
  </div>
</StudyLayout>
